# Copy this file to .env for local development.
# Never commit a real .env file or real credentials.

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info

# Reproducibility
RANDOM_SEED=42

# PostgreSQL — local development. Do not use a superuser for the app.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intelligent_search_recommendation
POSTGRES_TEST_DB=intelligent_search_recommendation_test
POSTGRES_USER=isre
POSTGRES_PASSWORD=change-me-locally

# Optional explicit SQLAlchemy URLs (override POSTGRES_* construction).
# DATABASE_URL=postgresql+psycopg://isre:change-me-locally@localhost:5432/intelligent_search_recommendation
# TEST_DATABASE_URL=postgresql+psycopg://isre:change-me-locally@localhost:5432/intelligent_search_recommendation_test

# Semantic retrieval. Artifacts are gitignored and rebuilt locally.
# SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# SEMANTIC_ARTIFACT_VERSION=amazon2023_all_beauty_phase2-v1__all-MiniLM-L6-v2__semantic-text-v1
# SEMANTIC_INDEX_TYPE=flat
# SEMANTIC_DEVICE=auto
# SEMANTIC_BATCH_SIZE=64
# SEMANTIC_HNSW_EF_SEARCH=64
# SEMANTIC_REQUIRE_INDEX=true
# ARTIFACTS_ROOT=artifacts

# Hybrid retrieval. fusion_method on the request overrides HYBRID_FUSION_METHOD.
# Omitted fusion_method still uses this config default. The demo sends fusion_method=weighted.
# HYBRID_FUSION_METHOD=rrf
# HYBRID_KEYWORD_WEIGHT=0.5
# HYBRID_RRF_K=60
# HYBRID_CANDIDATE_K_MAX=500
# HYBRID_CANDIDATE_K=

# Optional RankNet reranker. Not the search default.
# LTR_RANKER_VERSION=ranknet-v1
# LTR_RANKER_DIR=
# LTR_REQUIRE_RANKER=false

# Optional BPR-MF collaborative filter. Not the recommendation default.
# CF_MODEL_VERSION=bpr-mf-v1
# CF_MODEL_DIR=
# CF_REQUIRE_MODEL=false
